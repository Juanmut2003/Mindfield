{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "rootDir": "src",
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/main/**/*.ts"],
  // preload.ts is bundled by esbuild, not tsc: a sandboxed preload cannot
  // require() relative files, so tsc's multi-file output would break it. It
  // used to be emitted here and overwritten afterwards, which meant running
  // build:main alone left a broken preload behind. Excluding it from emit
  // removes that trap; tsconfig.test.json still type-checks the file.
  "exclude": ["src/main/**/*.test.ts", "src/main/preload.ts"]
}
